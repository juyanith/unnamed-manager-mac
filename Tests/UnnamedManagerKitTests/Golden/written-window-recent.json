{
  "version": 1,
  "windows": { "exclude": ["com.apple.finder", "notepad.exe"] },
  "entries": [
    { "keys": "Meh+W", "title": "Windows" },
    { "keys": "Meh+W Tab", "title": "Focus the window used before", "action": "window-focus-recent" },
    { "keys": "Meh+W S", "title": "Swap with the window used before", "action": "window-swap-recent" },
    { "keys": "Meh+W D", "title": "The window used before on this display", "action": "recent-here" },
    { "keys": "Meh+W O", "title": "Focus, old field name", "action": "recent-old" }
  ],
  "actions": {
    "recent-here": { "type": "window.focus", "target": "recent", "scope": "display" },
    "recent-old": { "type": "window.focus", "direction": "recent" }
  }
}
