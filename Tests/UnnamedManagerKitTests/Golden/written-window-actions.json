{
  "version": 1,
  "entries": [
    { "keys": "Meh+W", "title": "Windows" },
    { "keys": "Meh+W M", "title": "Maximize", "action": "maximize" },
    { "keys": "Meh+W F", "title": "Fill", "action": "fill" },
    { "keys": "Meh+W N", "title": "Minimize", "action": "minimize" },
    { "keys": "Meh+W H", "title": "Left half", "action": "left-half" },
    { "keys": "Meh+W T", "title": "Right third", "action": "right-third" },
    { "keys": "Meh+W C", "title": "Center", "action": "center" },
    { "keys": "Meh+W X", "title": "Middle", "action": "middle" },
    { "keys": "Meh+W Period", "title": "Move to center", "action": "move-center" },
    { "keys": "Meh+W Comma", "title": "Nudge right", "action": "nudge-right" },
    { "keys": "Meh+W Up", "title": "Nudge up", "action": "nudge-up" },
    { "keys": "Meh+W Equal", "title": "Half size", "action": "half-size" },
    { "keys": "Meh+W Minus", "title": "Bigger", "action": "bigger" },
    { "keys": "Meh+W Z", "title": "Taller", "action": "taller" },
    { "keys": "Meh+W RightBracket", "title": "Wider", "action": "wider" },
    { "keys": "Meh+W LeftBracket", "title": "Narrower", "action": "narrower" },
    { "keys": "Meh+W J", "title": "Focus left", "action": "focus-left" },
    { "keys": "Meh+W L", "title": "Focus right", "action": "focus-right" },
    { "keys": "Meh+W I", "title": "Focus up", "action": "focus-up" },
    { "keys": "Meh+W K", "title": "Focus down", "action": "focus-down" },
    { "keys": "Meh+W Tab", "title": "Next window", "action": "focus-next" },
    { "keys": "Meh+W Grave", "title": "Previous window", "action": "focus-previous" }
  ],
  "actions": {
    "maximize": { "type": "window.maximize" },
    "fill": { "type": "window.maximize", "toggle": false },
    "minimize": { "type": "window.minimize" },
    "left-half": { "type": "window.place", "preset": "leftHalf" },
    "right-third": { "type": "window.place", "preset": "rightThird" },
    "center": { "type": "window.place", "preset": "center" },
    "middle": { "type": "window.place", "frame": { "x": 0.1, "y": 0.05, "width": 0.8, "height": 0.9 } },
    "move-center": { "type": "window.move", "to": { "x": 0.5, "y": 0.5 } },
    "nudge-right": { "type": "window.move", "by": { "dx": 40 } },
    "nudge-up": { "type": "window.move", "by": { "dy": -40 } },
    "half-size": { "type": "window.resize", "to": { "width": 0.5, "height": 0.5 }, "anchor": "center" },
    "bigger": { "type": "window.resize", "by": { "dw": 80, "dh": 60 }, "anchor": "bottomRight" },
    "taller": { "type": "window.resize", "by": { "dh": 100 } },
    "wider": { "type": "window.resize", "step": "grow" },
    "narrower": { "type": "window.resize", "step": "shrink", "widths": [0.75, 0.5, 0.25] },
    "focus-left": { "type": "window.focus", "direction": "left" },
    "focus-right": { "type": "window.focus", "direction": "right" },
    "focus-up": { "type": "window.focus", "direction": "up" },
    "focus-down": { "type": "window.focus", "direction": "down" },
    "focus-next": { "type": "window.focus", "direction": "next" },
    "focus-previous": { "type": "window.focus", "direction": "previous" }
  }
}
